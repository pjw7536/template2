# 일반 설정은 Git으로 관리합니다. 비밀값은 같은 이름의 .secrets.env에 저장합니다.
# 사내 Kubernetes Portal Web 설정입니다. 실제 Portal 주소를 작성합니다.
# 브라우저에 공개됩니다. 비밀번호, token, client secret은 넣지 않습니다.

# 1. 브라우저 공개 주소 — API의 FRONTEND_BASE_URL과 맞춥니다.
VITE_SITE_URL=https://<Portal DNS>

# 2. API 연결 — 프록시가 /api와 /auth를 API로 전달합니다.
# API 경로는 코드가 붙이므로 여기에는 /api/v1을 붙이지 않습니다.
# BACKEND_API_URL도 브라우저 fallback으로 공개되는 값입니다.
VITE_BACKEND_URL=https://<Portal DNS>
BACKEND_API_URL=https://<Portal DNS>

# 3. 파일 접근 — 현재 Portal 프록시의 /minio/ 경로를 사용합니다.
VITE_MINIO_ENDPOINT=https://<Portal DNS>/minio

# 4. 화면 링크 — 사용하는 업무 도구만 실제 주소를 입력합니다.
VITE_PORTAL_PMX_URL=
VITE_PORTAL_MOSAIC_URL=
VITE_PORTAL_CONFLUENCE_URL=
VITE_DEFECT_SPIDER_URL=http://10.173.129.168:32600

# 5. 실행 옵션
NODE_ENV=production
