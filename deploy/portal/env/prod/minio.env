# 모든 운영 설정과 credential은 이 env 파일에서 함께 관리합니다.
# 사내 Kubernetes Portal MinIO 설정입니다. 기존 계정을 보존했으며 공개 주소는 배포 전에 확인합니다.

# 1. MinIO 관리자 계정 — 서버 기동용입니다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 2. API 접근 계정 — MinIO에 준비된 계정과 bucket 권한이 필요합니다.
# api.env의 MINIO_ACCESS_KEY와 MINIO_SECRET_KEY에도 동일한 접근 계정을 입력합니다.
# 이 파일만으로 별도 접근 계정이 자동 생성되지는 않습니다.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 3. 콘솔 공개 주소와 내부 API 연결 주소를 구분합니다.
# Portal Ingress와 같은 도메인을 사용하며 마지막 슬래시를 유지합니다.
MINIO_BROWSER_REDIRECT_URL=https://<Portal DNS>/minio-console/
# 콘솔이 호출하는 내부 S3 API 주소입니다. /minio 같은 경로 접두사는 허용하지 않습니다.
MINIO_SERVER_URL=http://minio:9000
