# 사내 Kubernetes Portal MinIO 설정입니다. minio.env로 복사한 뒤 실제 값을 작성합니다.

# 1. MinIO 관리자 계정 — 서버 기동용입니다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 2. API 접근 계정 — MinIO에 준비된 계정과 bucket 권한이 필요합니다.
# api.env의 MINIO_ACCESS_KEY와 MINIO_SECRET_KEY에도 동일한 접근 계정을 입력합니다.
# 이 파일만으로 별도 접근 계정이 자동 생성되지는 않습니다.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 3. 외부 공개 주소 — 파일 API와 관리 콘솔을 구분합니다.
# 현재 Portal 프록시는 관리 콘솔을 노출하지 않습니다. 별도 노출 후 주소를 입력합니다.
MINIO_BROWSER_REDIRECT_URL=
# 실제 Ingress 및 파일 API 공개 경로와 맞추고 업로드·다운로드를 확인합니다.
MINIO_SERVER_URL=https://<Portal DNS>/minio
