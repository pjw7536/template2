# 1. Keycloak 기동에 필요한 값입니다. 비밀번호는 각각 openssl rand -hex 32로 생성합니다.
postgres-password=1bf8f8b2bb951f289b5ab4d4502f70686acae4acabcd44b0f4b9e0b02db630ea
bootstrap-admin-username=etch-admin
bootstrap-admin-password=c62d799ea6db278826d793850e4e9dfbf18ab1903d42f69133ef5f3a3f2b704e
keycloak-public-url=https://etch-sso.samsungds.net

# 2. 사내 OIDC를 env로 등록할 때만 작성합니다. 기존 관리 화면 설정을 유지하면 비워둡니다.
CORP_OIDC_AUTH_URL=
CORP_OIDC_TOKEN_URL=
CORP_OIDC_ISSUER=
CORP_OIDC_CLIENT_ID=
CORP_OIDC_CLIENT_SECRET=
# 인프라에서 확인한 인증 방식을 입력합니다: client_secret_basic 또는 client_secret_post
CORP_OIDC_CLIENT_AUTH_METHOD=
CORP_OIDC_VALIDATE_SIGNATURE=true
CORP_OIDC_JWKS_URL=
# 선택값은 비워두면 기존 Identity Provider 설정을 유지합니다.
CORP_OIDC_USERINFO_URL=
CORP_OIDC_LOGOUT_URL=
