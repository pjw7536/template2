# 모든 운영 설정과 credential은 이 env 파일에서 함께 관리합니다.
# 1. Keycloak 기동에 필요한 값입니다. 비밀번호는 각각 openssl rand -hex 32로 생성합니다.
postgres-password=1bf8f8b2bb951f289b5ab4d4502f70686acae4acabcd44b0f4b9e0b02db630ea
bootstrap-admin-username=etch-admin
bootstrap-admin-password=dkssud123!
keycloak-public-url=https://etch-sso.samsungds.net

# 2. 사내 OIDC discovery 설정 입력입니다. 04_SETUP_FLOW.md의 keycloak-idp-setup 단계에서 사용합니다.
CORP_OIDC_CLIENT_ID=
CORP_OIDC_CLIENT_SECRET=
# 현재 provider의 Client secret sent in the request body 방식입니다.
CORP_OIDC_CLIENT_AUTH_METHOD=client_secret_post
CORP_OIDC_VALIDATE_SIGNATURE=true
# Discovery 전체 설정 명령에서 사용하는 metadata URL입니다.
CORP_OIDC_DISCOVERY_URL=https://stsds.secsso.net/adfs/.well-known/openid-configuration
