{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "minio-api",
        "labels": {
          "app.kubernetes.io/name": "minio",
          "app.kubernetes.io/part-of": "shared-storage"
        },
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.tls": "true",
          "traefik.ingress.kubernetes.io/router.middlewares": "minio-api@file"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "etch.samsungds.net",
            "http": {
              "paths": [
                {
                  "path": "/minio",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "minio",
                      "port": {
                        "name": "api"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "minio-console",
        "labels": {
          "app.kubernetes.io/name": "minio",
          "app.kubernetes.io/part-of": "shared-storage"
        },
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.tls": "true",
          "traefik.ingress.kubernetes.io/router.middlewares": "minio-console@file"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "etch.samsungds.net",
            "http": {
              "paths": [
                {
                  "path": "/minio-console",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "minio",
                      "port": {
                        "name": "console"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
