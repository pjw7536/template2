# 공용 MinIO 서버 설정입니다. 앱별 접근 키는 각 앱 env에서 관리합니다.
NODE_NAME=khplanew01
# Worker가 접근할 수 있는 사내 미러의 고정 이미지 주소입니다.
MINIO_IMAGE=repository.samsungds.net/proxy-docker-registry-1.docker.io/bitnamilegacy/minio:2025.7.23-debian-12-r5
MINIO_CLIENT_IMAGE=repository.samsungds.net/proxy-docker-registry-1.docker.io/bitnamilegacy/minio-client:2025.7.21-debian-12-r3
IMAGE_PULL_SECRET=
# 비우면 local PV와 저장 폴더를 자동으로 준비합니다. 동적 공급 시 실제 StorageClass를 지정합니다.
STORAGE_CLASS_NAME=
# 정적 모드에서 사용할 Worker의 데이터 경로입니다. 데이터 디스크 아래 경로를 지정합니다.
MINIO_DATA_HOST_PATH=/data/minio
VOLUME_NAME=
STORAGE_SIZE=10Gi
INGRESS_HOST=etch.samsungds.net
# 이전 env 호환용입니다. HTTPS 인증서는 공용 Traefik에서 관리합니다.
INGRESS_TLS_SECRET=
# 최초 준비할 버킷입니다. 다른 앱은 자기 버킷을 추가하고 별도 접근 키·정책을 준비합니다.
MINIO_BUCKETS=emails,profile
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BROWSER_REDIRECT_URL=https://etch.samsungds.net/minio-console/
MINIO_SERVER_URL=http://minio:9000
