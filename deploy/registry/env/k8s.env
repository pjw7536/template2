# 사내 이미지 저장소(Zot) 서버 설정입니다. push 계정은 Kubernetes Secret에만 등록합니다.
# 이 파일은 shell로 실행하지 않으며, REGISTRY_ENV로 다른 입력 파일을 지정할 수 있습니다.
NODE_NAME=khplanew01
# ghcr.io 사내 미러의 고정 tag 이미지입니다.
REGISTRY_IMAGE=repository.samsungds.net/proxy-docker-ghcr.io/project-zot/zot-linux-amd64:v2.1.20
# 같은 namespace에 미리 생성한 registry Secret 이름입니다. 인증이 없으면 비웁니다.
IMAGE_PULL_SECRET=
# 노드·빌드 호스트가 HTTPS로 접근할 이름입니다. DNS는 공용 Traefik APP VIP를 가리킵니다.
REGISTRY_HOST=store.etch.samsungds.net
# Worker의 이미지 저장 경로입니다. UID·GID 1000이 쓸 수 있게 미리 준비합니다.
DATA_HOST_PATH=/appdata/registry
STORAGE_SIZE=100Gi
