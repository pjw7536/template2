# 일반 설정은 Git으로 관리합니다. Grafana 관리자 계정은 별도 파일로 Secret을 등록합니다.
# KEY=값 형식입니다. 일반 설정은 Git에 포함합니다. 비밀번호를 넣지 않습니다.
NAMESPACE=monitoring
NODE_NAME=khinfow01
# 대상 Worker에서 없는 전용 디렉터리를 monitoring-up이 자동 생성합니다.
# 기존 폴더·파일 권한은 유지하며 데이터 디스크 마운트는 별도로 준비합니다.
DATA_HOST_PATH=/appdata/monitoring
# 사내 registry의 upstream별 proxy 경로를 입력합니다. 끝에 /를 붙이지 않습니다.
DOCKER_REGISTRY=repository.samsungds.net/proxy-docker-registry-1.docker.io
QUAY_REGISTRY=repository.samsungds.net/proxy-docker-quay.io
GHCR_REGISTRY=repository.samsungds.net/proxy-docker-ghcr.io
K8S_REGISTRY=repository.samsungds.net/proxy-docker-registry.k8s.io
# 인증이 필요한 경우 namespace에 먼저 만든 Secret 이름을 입력합니다.
IMAGE_PULL_SECRET=
# admin-user, admin-password 키를 가진 기존 Secret입니다.
GRAFANA_ADMIN_SECRET=monitoring-grafana-admin
# 공용 Traefik이 Grafana만 공개합니다.
INGRESS_ENABLED=true
GRAFANA_HOST=grafana.etch.samsungds.net
GRAFANA_SSO_ENABLED=true
GRAFANA_OIDC_REALM=etch
# 기존 입력 파일 호환용입니다. 직접 접속은 Kubernetes 내부 서비스를 사용합니다.
PROMETHEUS_HOST=
ALERTMANAGER_HOST=
