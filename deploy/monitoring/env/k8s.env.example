# KEY=값 형식입니다. 실제 파일은 Git에서 제외됩니다. 비밀번호를 넣지 않습니다.
NAMESPACE=monitoring
NODE_NAME=replace-me-node
# 빈 전용 디렉터리를 대상 worker에 미리 생성합니다.
DATA_HOST_PATH=/srv/monitoring
# 사내 registry의 upstream별 proxy 경로를 입력합니다. 끝에 /를 붙이지 않습니다.
DOCKER_REGISTRY=replace-me-docker-registry
QUAY_REGISTRY=replace-me-quay-registry
GHCR_REGISTRY=replace-me-ghcr-registry
K8S_REGISTRY=replace-me-k8s-registry
# 인증이 필요한 경우 namespace에 먼저 만든 Secret 이름을 입력합니다.
IMAGE_PULL_SECRET=
# admin-user, admin-password 키를 가진 기존 Secret입니다.
GRAFANA_ADMIN_SECRET=monitoring-grafana-admin
