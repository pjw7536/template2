{
  "uid": "servers-overview",
  "title": "전체 서버 · 리소스 추세",
  "description": "클러스터에 등록된 전체 서버의 상태와 리소스 추세를 비교합니다. 서버 이름은 kube-state-metrics의 Pod·노드 정보로 연결합니다.",
  "tags": [
    "servers",
    "infrastructure",
    "overview"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "node",
        "label": "서버",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_node_info, node)",
          "refId": "node-variable"
        },
        "definition": "label_values(kube_node_info, node)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      },
      {
        "name": "interface",
        "label": "네트워크 인터페이스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(node_network_receive_bytes_total{job=~\".*node-exporter.*\"}, device)",
          "refId": "interface-variable"
        },
        "definition": "label_values(node_network_receive_bytes_total{job=~\".*node-exporter.*\"}, device)",
        "regex": "/^(eth[0-9]+|en[a-zA-Z0-9_.:-]+|bond[0-9]+|team[0-9]+|wl[a-zA-Z0-9_.:-]+)$/",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "등록 서버",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (node) (kube_node_info{node=~\"${node:regex}\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "orange",
                  "text": "미수집"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "수집 정상",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((max by (node) ((up{job=~\".*node-exporter.*\"}) * on (namespace, pod) group_left (node) (max by (namespace, pod, node) (kube_pod_info{node=~\"${node:regex}\", pod=~\".*node-exporter.*\"})))) or on (node) (0 * (max by (node) (kube_node_info{node=~\"${node:regex}\"}))))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "orange",
                  "text": "미수집"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "수집 중단·미수집",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (node) (kube_node_info{node=~\"${node:regex}\"})) - sum((max by (node) ((up{job=~\".*node-exporter.*\"}) * on (namespace, pod) group_left (node) (max by (namespace, pod, node) (kube_pod_info{node=~\"${node:regex}\", pod=~\".*node-exporter.*\"})))) or on (node) (0 * (max by (node) (kube_node_info{node=~\"${node:regex}\"}))))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "orange",
                  "text": "미수집"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU 최고 사용률",
      "gridPos": {
        "x": 12,
        "y": 0,
