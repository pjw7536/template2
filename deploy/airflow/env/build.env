# 빌드 입력은 Git으로 관리하며 비밀번호·토큰은 넣지 않습니다.
# 사내 기본값은 apps/airflow/image/Dockerfile.dependencies와 일치시킨다. 빌드 도구는 이 값을 build arg로 전달한다.
# BigDataQuery Python·ODBC를 기본 설치하며 비밀번호·토큰은 넣지 않는다.
AIRFLOW_BASE_IMAGE=repository.samsungds.net/proxy-docker-registry-1.docker.io/apache/airflow:3.3.2-python3.12
APT_DEBIAN_REPOSITORY=http://repository.samsungds.net/repository/proxy-apt-mirror.kakao.com-debian
APT_DEBIAN_CODENAME=bookworm
APT_DEBIAN_ARCH=amd64
PIP_INDEX_URL=http://repository.samsungds.net/repository/proxy-pypi-files.pythonhosted.org/simple
PIP_EXTRA_INDEX_URL=http://nexus.adpaas.cloud.samsungds.net/repository/dataservice-pypi/simple
PIP_TRUSTED_HOST=repository.samsungds.net repo.samsungds.net nexus.adpaas.cloud.samsungds.net
INSTALL_BIGDATAQUERY_PYTHON=true
INSTALL_BIGDATAQUERY_ODBC=true
BIGDATAQUERY_ODBC_DEB_URL=http://nexus.adpaas.cloud.samsungds.net/repository/dataservice/odbc/linux/debian/clouderaimpalaodbc_2.8.3.1008-2_amd64.deb
