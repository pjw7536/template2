# 모든 운영 설정과 credential은 이 env 파일에서 함께 관리합니다.
# init-secrets는 DB 비밀번호·관리자 비밀번호·Fernet 키·웹 서버 키를 생성합니다.

# ── 배포 위치 ──
# 전용 namespace를 지정한다. Helm release 이름은 airflow로 고정한다.
NAMESPACE=airflow
# kubectl get nodes -L kubernetes.io/hostname 으로 확인한 hostname label 값
NODE_NAME=khinfow01

# ── Airflow 이미지 ──
# apps/airflow/image/Dockerfile로 빌드한 이미지를 Worker의 containerd에 반입한다.
# 이 이름은 registry 주소가 아니다. 재빌드마다 새 태그로 빌드·반입한다.
AIRFLOW_IMAGE_REPOSITORY=airflow
AIRFLOW_IMAGE_TAG=3.3.2-release-1
# namespace 안에 미리 만든 registry Secret. 공개 이미지 또는 노드 사전 로딩이면 비운다.
IMAGE_PULL_SECRET=

# ── PostgreSQL 연결 ──
# 외부 DB 모드에서는 PostgreSQL workload·DB PV를 배포하지 않는다.
POSTGRES_MODE=internal
POSTGRES_HOST=airflow-postgres
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=-cIHpsUAwOS1Da8rqd4VLJNttA5sjYkTDL1bdNxDtKI

# ── 내부 PostgreSQL 이미지·저장소 ──
# PostgreSQL 16의 Debian 계열 이미지 사용. 아래 UID/GID는 해당 이미지와 맞춘다.
POSTGRES_IMAGE=repository.samsungds.net/proxy-docker-registry-1.docker.io/postgres:16
POSTGRES_UID=999
POSTGRES_GID=999
# 디렉터리를 서버에서 미리 생성한다. 기존 Compose DB 경로를 직접 지정하지 않는다.
POSTGRES_HOST_PATH=/appdata/airflow/postgres
POSTGRES_STORAGE_SIZE=20Gi

# ── Airflow 로그 저장소 ──
# 로그 디렉터리를 서버에서 미리 생성한다.
LOGS_HOST_PATH=/appdata/airflow/logs
LOGS_STORAGE_SIZE=20Gi

# ── ODBC 설정 마운트 ──
# 기존 airflow/odbc 디렉터리의 서버 절대 경로를 지정한다. 전체를 읽기 전용으로 마운트한다.
ODBC_HOST_PATH=/appdata/airflow/odbc
# Secret 방식이면 ODBC_HOST_PATH를 비우고 이 값을 지정한다. 두 방식은 동시에 사용하지 않는다.
ODBC_SECRET_NAME=

# ── 웹 접속·Ingress ──
AIRFLOW_WEBSERVER_BASE_URL=https://etch.samsungds.net/airflow
# 기존 ingress controller가 있으면 true. false이면 port-forward로 접속한다.
INGRESS_ENABLED=true
# HTTPS 인증서는 공용 Traefik에서 관리한다.
INGRESS_CLASS_NAME=traefik

# ── 관리자 계정·Airflow 암호화 키 ──
AIRFLOW_ADMIN_USERNAME=airflow
# 관리자 계정 식별용 이메일이며 수신 가능한 메일함인지는 별도 확인한다.
AIRFLOW_ADMIN_EMAIL=admin@admin.com
# 서버 배포 전에 아래 임시 비밀번호를 실제 관리자 비밀번호로 교체한다.
AIRFLOW_ADMIN_PASSWORD=replace-here-before-deploy
# 기존 DB 이전 시 Fernet 키는 기존 값을 유지한다.
AIRFLOW_FERNET_KEY=TE3gr6DAx9roLhXs7GQ8johs2PpZse3CpWkHuV3vkUo=
AIRFLOW_WEBSERVER_SECRET_KEY=GgJiLWkvSQfcFBj5suEQcFVqq_ipCEtZWTbIqIC9vHc

# ── Keycloak 로그인·OIDC 연결 ──
# 운영 기본 인증은 Keycloak이다. db는 기존 웹 로그인 복구용이다.
AIRFLOW_AUTH_MODE=keycloak
# 브라우저 로그인과 토큰 발급자 검증에 사용하는 공개 realm URL이다.
AIRFLOW_OIDC_ISSUER=https://etch-sso.samsungds.net/realms/etch
AIRFLOW_OIDC_CLIENT_ID=airflow
# 서버 배포 전에 replace-here를 Keycloak airflow client에 등록된 실제 secret으로 교체한다.
AIRFLOW_OIDC_CLIENT_SECRET=replace-here
# Pod가 토큰·공개키를 조회하는 realm URL이다. 비우면 issuer를 사용한다.
AIRFLOW_OIDC_BACKCHANNEL_BASE_URL=
# localhost 개발 환경의 HTTP 예외다. 서버에서는 false를 유지한다.
AIRFLOW_OIDC_ALLOW_HTTP=false

# ── OIDC HTTPS 인증서 신뢰: 사내 CA가 필요한 경우만 설정 ──
# Airflow Pod에서 Keycloak 인증서를 기본 신뢰 저장소로 검증할 수 있으면 두 값 모두 비운다.
# 기본으로 신뢰하지 않는 사내 CA를 쓰면 필요한 루트·중간 CA를 ca.crt 키의 ConfigMap으로 준비한다.
# 아래 두 값을 함께 설정한다. HTTPS 인증서 검증은 빈 값이어도 계속 수행한다.
# Pod 내부 CA 파일 경로: /etc/airflow/oidc-ca/ca.crt
AIRFLOW_OIDC_CA_BUNDLE=
# 위 CA 파일을 읽기 전용으로 마운트할 동일 namespace의 ConfigMap 이름
AIRFLOW_OIDC_CA_CONFIGMAP=

# ── Portal API 연동 ──
# Portal이 같은 클러스터에 배포된 현재 namespace 기준 주소다.
AIRFLOW_API_BASE_URL=http://api.tailwind-internal.svc.cluster.local:8000
# Portal API의 AIRFLOW_TRIGGER_TOKEN과 반드시 동일하게 입력한다.
AIRFLOW_TRIGGER_TOKEN=5ca99f0ae7b1fcd3f958ebb1c2ee4639d0a8fada21e8ff009d27f42cd2bbf31e

# ── 실패 알림: Knox Messenger ──
KNOX_MESSENGER_API_BASE_URL=
KNOX_MESSENGER_AUTHORIZATION=
KNOX_MESSENGER_SYSTEM_ID=
AIRFLOW_FAILURE_ALERT_KNOX_IDS=

# ── 실패 알림: Knox Mail ──
# 수신자를 비우면 메일 알림만 생략한다. 두 채널을 모두 설정하면 각각 전송한다.
# 기존 Knox Mail API 계약을 사용하며 실제 발송 계정과 권한이 필요하다.
MAIL_API_URL=
MAIL_API_KEY=
MAIL_API_SYSTEM_ID=plane
MAIL_API_KNOX_ID=
AIRFLOW_FAILURE_ALERT_EMAIL_FROM=
AIRFLOW_FAILURE_ALERT_EMAIL_TO=
