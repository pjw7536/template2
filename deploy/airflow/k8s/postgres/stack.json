{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "airflow-postgres",
        "namespace": "__NAMESPACE__"
      },
      "spec": {
        "clusterIP": "None",
        "selector": {
          "app.kubernetes.io/name": "airflow-postgres"
        },
        "ports": [
          {
            "name": "postgres",
            "port": 5432,
            "targetPort": "postgres"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "airflow-postgres",
        "namespace": "__NAMESPACE__"
      },
      "spec": {
        "serviceName": "airflow-postgres",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "airflow-postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "airflow-postgres"
            }
          },
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "__NODE_NAME__"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              },
              {
                "key": "node-role.kubernetes.io/master",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": "__POSTGRES_UID__",
              "runAsGroup": "__POSTGRES_GID__",
              "fsGroup": "__POSTGRES_GID__"
            },
            "terminationGracePeriodSeconds": 60,
            "containers": [
              {
                "name": "postgres",
                "image": "__POSTGRES_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "postgres",
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "airflow"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "airflow"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "airflow-postgres",
                        "key": "password"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "2Gi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "airflow",
                      "-d",
                      "airflow"
                    ]
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "airflow",
                      "-d",
                      "airflow"
                    ]
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "airflow",
                      "-d",
                      "airflow"
                    ]
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "airflow-postgres"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
