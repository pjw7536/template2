{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "__NAMESPACE__-airflow-postgres"
      },
      "spec": {
        "capacity": {
          "storage": "__POSTGRES_STORAGE_SIZE__"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "",
        "claimRef": {
          "namespace": "__NAMESPACE__",
          "name": "airflow-postgres"
        },
        "local": {
          "path": "__POSTGRES_HOST_PATH__"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "__NODE_NAME__"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "airflow-postgres",
        "namespace": "__NAMESPACE__"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "",
        "volumeName": "__NAMESPACE__-airflow-postgres",
        "resources": {
          "requests": {
            "storage": "__POSTGRES_STORAGE_SIZE__"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "__NAMESPACE__-airflow-logs"
      },
      "spec": {
        "capacity": {
          "storage": "__LOGS_STORAGE_SIZE__"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "",
        "claimRef": {
          "namespace": "__NAMESPACE__",
          "name": "airflow-logs"
        },
        "local": {
          "path": "__LOGS_HOST_PATH__"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "__NODE_NAME__"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "airflow-logs",
        "namespace": "__NAMESPACE__"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "",
        "volumeName": "__NAMESPACE__-airflow-logs",
        "resources": {
          "requests": {
            "storage": "__LOGS_STORAGE_SIZE__"
          }
        }
      }
    }
  ]
}
