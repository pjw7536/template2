# ghcr.io의 사내 미러 경로를 scheme 없이 입력합니다.
HEADLAMP_REGISTRY=repository.samsungds.net/proxy-docker-ghcr.io
# 같은 namespace에 미리 생성한 registry Secret 이름입니다. 인증이 없으면 비웁니다.
IMAGE_PULL_SECRET=
# HTTPS 접속 시 두 항목을 함께 설정합니다. 비워 두면 port-forward만 사용합니다.
HEADLAMP_HOST=etch.samsungds.net
# headlamp namespace에 사내 발급 인증서를 먼저 등록합니다.
HEADLAMP_TLS_SECRET=headlamp-tls
