# 일반 설정은 Git으로 관리합니다. Client secret은 Kubernetes Secret에만 등록합니다.
# 이 파일은 shell로 실행하지 않으며, HEADLAMP_ENV로 다른 입력 파일을 지정할 수 있습니다.
# ghcr.io의 사내 미러 경로를 scheme 없이 입력합니다.
HEADLAMP_REGISTRY=repository.samsungds.net/proxy-docker-ghcr.io
# 같은 namespace에 미리 생성한 registry Secret 이름입니다. 인증이 없으면 비웁니다.
IMAGE_PULL_SECRET=
# Headlamp 공개 host입니다. 이 host의 HTTPS 루트에서 OIDC callback을 받습니다.
HEADLAMP_HOST=headlamp.etch.samsungds.net

# 현재 운영 Keycloak realm의 HTTPS issuer입니다. 끝에 /를 붙이지 않습니다.
HEADLAMP_OIDC_ISSUER_URL=https://sso.etch.samsungds.net/realms/etch
HEADLAMP_OIDC_CLIENT_ID=headlamp
# headlamp namespace의 Secret 이름. 키는 OIDC_CLIENT_SECRET 하나만 둡니다.
HEADLAMP_OIDC_SECRET=headlamp-oidc
# 사내 CA 사용 시 ca.crt 키가 있는 ConfigMap 이름입니다. 공개 CA라면 비웁니다.
HEADLAMP_OIDC_CA_CONFIGMAP=headlamp-oidc-ca
