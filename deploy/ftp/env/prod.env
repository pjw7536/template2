# 사내 Docker Hub 미러를 사용합니다. 경로와 digest 제공 여부는 Worker에서 확인하세요.
FTP_IMAGE=repository.samsungds.net/proxy-docker-registry-1.docker.io/fauria/vsftpd@sha256:6d71d7c7f1b0ab2844ec7dc7999a30aef6d758b6d8179cf5967513f87c79c177
# registry 인증이 필요하면 etch-ftp namespace에 미리 준비한 Secret 이름을 지정하세요.
IMAGE_PULL_SECRET=
# 기본적으로 FTP_NODES에 지정한 control plane도 허용합니다. 역할 NoSchedule만 허용합니다.
FTP_ALLOW_CONTROL_PLANE=true
