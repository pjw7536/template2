# 권한관리(IAM) 배포 입력. 같은 이름의 환경변수를 주면 그 값이 우선합니다.

# 권한관리 웹의 공개 주소(HTTPS, 경로 없음). Keycloak client의 redirect URI와 web origin에 씁니다.
IAM_PUBLIC_URL=https://members.etch.samsungds.net

# 설정을 적용할 업무 realm
KEYCLOAK_TARGET_REALM=etch

# 플랫폼 관리자 그룹에 추가할 기존 Keycloak username 목록입니다. 여러 명은 쉼표로 구분합니다.
IAM_PLATFORM_ADMIN_USERNAMES=
