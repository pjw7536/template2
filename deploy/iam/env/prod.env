# Etch Members 운영 배포 입력입니다.

# Etch Members의 공개 주소(HTTPS, 경로 없음). Keycloak client의 redirect URI와 web origin에 씁니다.
IAM_PUBLIC_URL=https://members.etch.samsungds.net

# 설정을 적용할 업무 realm
KEYCLOAK_TARGET_REALM=etch

# 플랫폼 관리자 그룹에 추가할 기존 계정의 Keycloak username(EPID) 목록입니다. 여러 명은 쉼표로 구분합니다.
IAM_PLATFORM_ADMIN_USERNAMES=

# 업무 부하 SQLite를 보관하는 Worker의 hostname label과 전용 경로입니다.
IAM_STORAGE_NODE=khinfow01
IAM_DATA_HOST_PATH=/appdata/iam
