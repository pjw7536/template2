# 노드 명령 실행(deploy/shared/scripts/node_exec.py) 입력. 같은 이름의 환경변수를 주면 그 값이 우선합니다.

# 노드에서 명령을 실행할 Pod의 이미지. 셸이 있고 모든 노드가 사내 미러에서 받을 수 있어야 합니다.
NODE_EXEC_IMAGE=repository.samsungds.net/proxy-docker-registry-1.docker.io/library/busybox:1.37.0

# 일회성 Job을 만들 namespace. 특권 Pod를 허용하는 namespace여야 합니다.
NODE_EXEC_NAMESPACE=kube-system
