# Portal local / api-k8s.env: 파일 역할과 적용 순서는 env/portal/README.md를 참고합니다.
# 기존 값과 빈 값은 그대로 유지합니다. 기본값으로 되돌리려고 임의로 삭제하지 않습니다.
# local/api.env에 한 번만 덮어쓰는 Kubernetes 전용 차이입니다. credential은 로컬 테스트 전용입니다.

# 1. 서버와 공개 주소 — 처음 배포할 때 확인
ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,api.tailwind-local.svc.cluster.local,edge-nginx
FRONTEND_BASE_URL=http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# 2. 데이터베이스 — Portal DB 연결 정보
# EPID 이전의 dashboard DB를 보존하고 새 인증용 DB를 사용합니다.
DJANGO_DB_NAME=dashboard_keycloak
DJANGO_DB_USER=portal
DJANGO_DB_HOST=external-postgres
DJANGO_DB_PORT=5432
DJANGO_DB_PASSWORD=portal-local-only

# 3. 로그인 — 선택한 provider의 연결 정보
ALLOWED_REDIRECT_HOSTS=localhost:8080
OIDC_PROVIDER=keycloak
OIDC_CLIENT_ID=portal
OIDC_ISSUER=http://localhost:8180/realms/portal
OIDC_AUTH_URL=http://localhost:8180/realms/portal/protocol/openid-connect/auth
OIDC_LOGOUT_URL=http://localhost:8180/realms/portal/protocol/openid-connect/logout
OIDC_REDIRECT_URI=http://localhost:8080/auth/keycloak/callback/
OIDC_TOKEN_URL=http://keycloak:8080/realms/portal/protocol/openid-connect/token
OIDC_JWKS_URL=http://keycloak:8080/realms/portal/protocol/openid-connect/certs
OIDC_CLIENT_SECRET=portal-local-secret

# 5. 공용 연동 / MinIO — API에서 사용하는 연결 정보
MINIO_ENDPOINT=http://minio:9000
