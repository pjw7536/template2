# Portal local / minio.env: 파일 역할과 적용 순서는 env/portal/README.md를 참고합니다.
# 기존 값과 빈 값은 그대로 유지합니다. 기본값으로 되돌리려고 임의로 삭제하지 않습니다.

# 1. MinIO 관리자 계정 — 서버 기동용
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 2. API 접근 계정 — MinIO에 존재하는 계정과 일치해야 함
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 3. 외부 공개 주소 — API와 관리 콘솔 경로는 서로 다름
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SERVER_URL=http://localhost:9000
