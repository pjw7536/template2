# Portal local / web.env: 파일 역할과 적용 순서는 env/portal/README.md를 참고합니다.
# 기존 값과 빈 값은 그대로 유지합니다. 기본값으로 되돌리려고 임의로 삭제하지 않습니다.
# 브라우저에 공개되는 설정입니다. 비밀번호, token, client secret을 넣지 않습니다.

# 1. 브라우저 공개 주소 — 사용자가 접속하는 URL
VITE_SITE_URL=http://localhost:5173

# 2. API 연결 — BACKEND_API_URL도 브라우저 fallback으로 공개됨
VITE_BACKEND_URL=http://localhost:8000
BACKEND_API_URL=http://api:8000

# 3. 파일 접근 — 브라우저에서 접근 가능한 MinIO 주소
VITE_MINIO_ENDPOINT=https://stg.plane.samsungds.net/minio

# 4. 화면 링크 — 사용하는 업무 도구의 주소
VITE_PORTAL_PMX_URL=
VITE_PORTAL_MOSAIC_URL=
VITE_PORTAL_CONFLUENCE_URL=
VITE_DEFECT_SPIDER_URL=http://10.173.129.168:32600

# 5. 실행 옵션 — 기존 개발 및 운영 값 유지
NODE_ENV=development
NPM_CONFIG_PRODUCTION=false
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
