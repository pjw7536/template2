# 한 PC의 로컬 실행 입력입니다. 상대 경로는 저장소 루트를 기준으로 해석합니다.
LOCAL_DB_PORT=55432
LOCAL_FTP_PORT=6380
LOCAL_FTP_PASSIVE_START=8076
# 반입된 Docker 이미지를 우선 사용합니다. 별도 registry를 쓰면 이 값만 바꿉니다.
LOCAL_MINIO_IMAGE=minio/minio:latest
LOCAL_MINIO_CLIENT_IMAGE=minio/mc:latest
LOCAL_RUNTIME_DATA_HOST_PATH=data/k8s-local
DATA_MOVEMENT_HOST_PATH=data/data_movement
L3_SPIDER_DATA_HOST_PATH=data/l3_spider/daily_anomaly
TTTM_SPIDER_DATA_HOST_PATH=data/tttm_spider
PM_COMPARISON_DATA_HOST_PATH=data/pm_spider
