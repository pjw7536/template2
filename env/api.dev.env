# ============================================================================== 
# Django 개발 환경 전용 재정의
# ------------------------------------------------------------------------------
# docker-compose.dev.yml 에서 api.common.env 다음에 로드됩니다.
# - FastAPI 기반 더미 ADFS 서버 연동
# - 코드 변경 사항을 runserver 핫리로드로 즉시 반영
# - HTTP 로컬 리버스 프록시(default.conf) 전제
# ============================================================================== 

# --- 런타임 메타데이터 --------------------------------------------------------
ENVIRONMENT=development
DEV_AUTO_AFFILIATION_ALLOWED=1
DEV_AUTO_AFFILIATION_PREFIX=DEV
DEV_AUTO_SEED=1
DEV_SEED_PREFIX=DEV
DJANGO_SECRET_KEY=local-dev-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,stg.plane.samsungds.net

# --- 프런트엔드 ↔ 백엔드 URL --------------------------------------------------
# 개발용 Nginx :80 에서 / (프론트엔드) 와 /api (Django)를 동시에 노출
FRONTEND_BASE_URL=http://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
PUBLIC_API_BASE_URL=/api

# --- L3 Spider 개발용 mock ---------------------------------------------------
# 로컬 mount의 Parquet와 read-only SQLite 인덱스를 사용합니다.
L3_SPIDER_INDEX_SOURCE=sqlite_mock
L3_SPIDER_MOCK_INDEX_PATH=/data/l3_spider/daily_anomaly/_meta/index.sqlite3

# --- 보안 토글 --------------------------------------------------------
# 로컬 개발 시 HTTPS 관련 강제 옵션을 모두 해제합니다.
DJANGO_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# 로컬 HTTP 환경에서 세션 쿠키가 동작하도록 Secure/SameSite 정책을 완화합니다.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# --- 로컬 Keycloak ----------------------------------------------------------
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=portal
KEYCLOAK_CLIENT_SECRET=portal-local-secret
KEYCLOAK_ADMIN_CLIENT_ID=portal-admin-reader
KEYCLOAK_ADMIN_CLIENT_SECRET=portal-admin-reader-local-secret
KEYCLOAK_MIGRATION_CLIENT_ID=portal-migration
KEYCLOAK_MIGRATION_CLIENT_SECRET=portal-migration-local-secret
KEYCLOAK_AUTH_URL=http://localhost:8180/realms/portal/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/portal/protocol/openid-connect/token
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/portal/protocol/openid-connect/certs
KEYCLOAK_LOGOUT_URL=http://localhost:8180/realms/portal/protocol/openid-connect/logout
OIDC_CLIENT_ID=portal
OIDC_ISSUER=http://localhost:8180/realms/portal
OIDC_REDIRECT_URI=http://localhost/auth/keycloak/callback/
ALLOWED_REDIRECT_HOSTS=samsungds.net,samsungds.net:8003

# --- 더미 외부 연동(FastAPI) ------------------------------------------------
# adfs 서비스는 RAG/mail/Jira 개발용 mock으로만 유지합니다.
DUMMY_ADFS_EMAIL=dummy.user@example.com
DUMMY_ADFS_NAME=Dummy User
DUMMY_ADFS_SABUN=S000001
DUMMY_ADFS_LOGINID=dummy.user
DUMMY_ADFS_DEPT=Development

# --- Assistant 업스트림 (adfs_dummy 경유 OpenWebUI 호환 API) -----------------
# 개발 환경에서는 Django assistant가 실제 OpenWebUI를 호출하지 않고
# docker-compose.dev.yml 의 adfs_dummy(FastAPI)로 라우팅합니다.
ASSISTANT_DUMMY_MODE=0
ASSISTANT_DUMMY_USE_RAG=1
OPENWEBUI_URL=http://adfs:9000/v1/chat/completions
OPENWEBUI_MODEL=dummy-model

# --- 더미 RAG/메일 엔드포인트 (adfs_dummy) -----------------------------------
RAG_SEARCH_URL=http://adfs:9000/rag/search
RAG_INSERT_URL=http://adfs:9000/rag/insert
RAG_DELETE_URL=http://adfs:9000/rag/delete
RAG_INDEX_NAME=rp-unclassified
RAG_INDEX_LIST=rp-unclassified,rp-emails
RAG_INDEX_DEFAULT=rp-unclassified
RAG_INDEX_EMAILS=rp-emails
RAG_INDEX_INFO_URL=http://adfs:9000/rag/index-info

ASSISTANT_RAG_URL=http://adfs:9000/rag/search
ASSISTANT_RAG_INSERT_URL=http://adfs:9000/rag/insert
ASSISTANT_RAG_DELETE_URL=http://adfs:9000/rag/delete
ASSISTANT_RAG_INDEX_INFO_URL=http://adfs:9000/rag/index-info
ASSISTANT_RAG_INDEX_NAME=rp-unclassified
ASSISTANT_RAG_PERMISSION_GROUPS=["rag-public"]
ASSISTANT_RAG_HEADERS={}
ASSISTANT_RAG_NUM_DOCS=5

# --- Knox 메일 전송 API (adfs_dummy 경유 더미) -------------------------------
MAIL_API_URL=http://adfs:9000/mail/send
MAIL_API_KEY=dummy-ticket
MAIL_API_SYSTEM_ID=plane
MAIL_API_KNOX_ID=dummy-knox-id
L3_SPIDER_MAIL_SENDER=dummy.user@example.com

# --- Airflow 트리거 인증 (공통) -------------------------------------------
AIRFLOW_TRIGGER_TOKEN=5ca99f0ae7b1fcd3f958ebb1c2ee4639d0a8fada21e8ff009d27f42cd2bbf31e

# --- Drone SOP 적재/Jira (adfs_dummy 경유 더미) ----------------------------
DRONE_SOP_DUMMY_MODE=1
# docker-compose.dev 환경에서만 더미 시드 커맨드 허용
DRONE_SEED_ALLOWED=1
DRONE_SOP_DUMMY_MAIL_MESSAGES_URL=http://adfs:9000/mail/messages
DRONE_SOP_DEFECTMAP_URL=
DRONE_JIRA_BASE_URL=http://adfs:9000/jira
DRONE_JIRA_TOKEN=dummy-token
DRONE_JIRA_ISSUE_TYPE=Task

# --- Grist OSS Work Hub 개발 opt-in -----------------------------------------
WORK_HUB_ENABLED=0
GRIST_LOGOUT_ENABLED=0
GRIST_API_URL=http://grist:8484/o/work-hub
GRIST_API_KEY=
GRIST_API_KEY_FILE=/run/work-hub/grist_api_key
GRIST_PUBLIC_URL=http://localhost:8100
GRIST_ADMIN_EMAIL=dummy.user@example.com
GRIST_ORG=work-hub
GRIST_ALLOWED_LAUNCH_HOSTS=localhost
GRIST_WEBHOOK_CALLBACK_URL=http://api:8000/api/v1/work-hub/webhooks/grist
GRIST_WEBHOOK_SECRET=local-work-hub-webhook-secret
GRIST_FORWARD_AUTH_TICKET_SECRET=work-hub-local-forward-auth-secret-change-me
GRIST_FORWARD_AUTH_TICKET_MAX_AGE_SECONDS=30
GRIST_FORWARD_AUTH_LOGIN_PATH=/auth/login
GRIST_DEV_USER_SDWT_PROD=DEV_ALPHA
GRIST_DEV_KEYCLOAK_GROUP_ID=aff-dev-alpha-parent
