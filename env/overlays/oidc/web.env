# OIDC Web 전체 환경변수입니다.
# 브라우저에 전달 가능한 비민감 설정만 둡니다.

# Node 실행 및 개발 설정
NODE_ENV=development
NPM_CONFIG_PRODUCTION=false
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# 백엔드 연결
VITE_BACKEND_URL=/
BACKEND_API_URL=http://api:8000

# MinIO 연결
VITE_MINIO_ENDPOINT=https://stg.plane.samsungds.net/minio

# 사이트 URL
VITE_SITE_URL=https://stg.plane.samsungds.net

# Portal 및 Spider 외부 링크
VITE_PORTAL_PMX_URL=
VITE_PORTAL_MOSAIC_URL=
VITE_PORTAL_CONFLUENCE_URL=
VITE_DEFECT_SPIDER_URL=http://10.173.129.168:32600
