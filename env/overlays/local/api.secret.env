# Kubernetes Secret 전환을 위한 local API 설정입니다.
# Docker Compose는 이 파일을 config env 다음에 읽습니다.

# Django 비밀값
DJANGO_SECRET_KEY=local-dev-secret

# 관리자 인증
DJANGO_SUPERUSER_PASSWORD=dkssud123!

# 데이터베이스 인증
DJANGO_DB_PASSWORD=airflow

# Airflow 인증
AIRFLOW_PASSWORD=airflow
AIRFLOW_TRIGGER_TOKEN=5ca99f0ae7b1fcd3f958ebb1c2ee4639d0a8fada21e8ff009d27f42cd2bbf31e

# Email 및 OCR 인증
EMAIL_OCR_INTERNAL_TOKEN=dummy-ocr-token

# OpenWebUI 인증
OPENWEBUI_API_TOKEN=dev-openwebui-token
OPENWEBUI_COMMON_HEADERS={}

# RAG 인증
RAG_HEADERS={}

# Mail API 인증
MAIL_API_KEY=dummy-ticket

# Drone Jira 인증
DRONE_JIRA_TOKEN=dummy-token

# Knox Messenger 인증
KNOX_MESSENGER_AUTHORIZATION=
