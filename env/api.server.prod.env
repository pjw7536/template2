# ==============================================================================
# Django 운영 서버 전용 설정
# ------------------------------------------------------------------------------
# docker-compose.yml에서 api.server.common.env 다음에 로드됩니다.
# - 운영 서버의 실행, DB, credential, 인증서 설정을 포함합니다.
# - 기존 운영 profile 값을 유지하며 서버별 값은 배포 전에 확인합니다.
# - 코드 변경 시 컨테이너를 재배포하기 전까지 반영되지 않습니다.
# - HTTPS 종단은 deploy/nginx/inner.conf.backup 를 사용하는 내부 Nginx 로 마무리합니다.
# ==============================================================================

# --- 런타임 메타데이터 --------------------------------------------------------
ENVIRONMENT=production
DJANGO_SECRET_KEY=b8b5716bd42731f4621862441d420c9087541e5140c32ecbd1e05ecf76476071c392a15d40f7e86be356eeeae2cdc82b
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api,web,example.com,stg.plane.samsungds.net

# --- 서버 DB와 superuser -----------------------------------------------------
DJANGO_SUPERUSER_SABUN=00000000
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=etch_mail_collector@samsung.com
DJANGO_SUPERUSER_PASSWORD=dkssud123!
DJANGO_DB_NAME=dashboard
DJANGO_DB_USER=airflow
DJANGO_DB_PASSWORD=airflow
DJANGO_DB_HOST=airflow-postgres
DJANGO_DB_PORT=8010

# --- 프런트엔드 ↔ 백엔드 URL --------------------------------------------------
FRONTEND_BASE_URL=https://stg.plane.samsungds.net
DJANGO_CORS_ALLOWED_ORIGINS=https://stg.plane.samsungds.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://stg.plane.samsungds.net

# --- OIDC / ADFS --------------------------------------------------------------
OIDC_CLIENT_ID=
OIDC_ISSUER=
ADFS_AUTH_URL=
ADFS_LOGOUT_URL=
OIDC_REDIRECT_URI=
ALLOWED_REDIRECT_HOSTS=stg.plane.samsungds.net

# --- 보안 토글 --------------------------------------------------------
# 운영에서는 HTTPS + HSTS 강제. 프록시 체인에 맞게 값 조정 가능
DJANGO_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# --- 사내 ADFS 인증서 ---------------------------------------------------
ADFS_CER_PATH=

# --- RAG 인증 ---------------------------------------------------------------
RAG_HEADERS={"Content-Type":"application/json","x-dep-ticket":"token","api-key":"apikey"}

# --- Email / Mail API ---------------------------------------------------------
EMAIL_POP3_USERNAME=
EMAIL_POP3_PASSWORD=
MAIL_API_KEY=
MAIL_API_KNOX_ID=jw0509.park

# --- Drone / Jira / Messenger ------------------------------------------------
DRONE_SOP_POP3_USERNAME=
DRONE_SOP_POP3_PASSWORD=
DRONE_JIRA_USER=
DRONE_JIRA_TOKEN=
DRONE_MAIL_SENDER=etch_mail_collector@samsung.com
KNOX_MESSENGER_AUTHORIZATION=
KNOX_MESSENGER_SYSTEM_ID=

# --- L3 Spider / OpenWebUI 인증 ---------------------------------------------
L3_SPIDER_MAIL_SENDER=etch_mail_collector@samsung.com
L3_SPIDER_MAIL_TARGET_URL=
OPENWEBUI_API_TOKEN=dev-openwebui-token
OPENWEBUI_COMMON_HEADERS={}
