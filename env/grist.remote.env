# 10.172.117.91 전용 Grist 서버의 비밀값 제외 배포 기본값입니다.
WORK_HUB_ENABLED=0

GRIST_PUBLIC_URL=http://10.172.117.91
GRIST_WIDGET_PUBLIC_URL=http://10.172.117.91:8101
GRIST_HTTP_PORT=80
GRIST_WIDGET_PORT=8101
GRIST_ORG=work-hub
GRIST_ADMIN_EMAIL=jw0509.park@samsung.com
GRIST_ALLOWED_WEBHOOK_DOMAINS=plane.samsungds.net,stg.plane.samsungds.net

# 신규 서버에서 기존 Portal로 로그인 검증을 요청합니다.
PORTAL_PUBLIC_URL=https://plane.samsungds.net
PORTAL_VERIFY_URL=https://plane.samsungds.net/auth/grist/verify

# 실제 값은 `GRIST_SESSION_SECRET=... make grist-remote-up`처럼 배포 secret으로 주입합니다.
GRIST_SESSION_SECRET=
WORK_HUB_SECRET_HOST_PATH=./data/work_hub_secrets/remote
# 신규 서버의 배포 사용자 UID/GID와 맞춰 `0600` key 파일을 읽을 수 있게 합니다.
GRIST_SECRET_UID=1000
GRIST_SECRET_GID=1000
GRIST_DATA_VOLUME=tailwind_grist_remote_data
GRIST_NETWORK_NAME=tailwind-grist-remote
GRIST_COMPOSE_PROJECT_NAME=tailwind-grist-remote
