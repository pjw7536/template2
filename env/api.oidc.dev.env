# ==============================================================================
# Django OIDC 개발 환경 전용 설정
# ------------------------------------------------------------------------------
# docker-compose.oidc.yml에서 api.server.common.env 다음에 로드합니다.
# - 개발용 디버그/보안 완화 값과 OIDC 인증서 차이만 포함합니다.
# ==============================================================================

# --- Runtime metadata --------------------------------------------------------
ENVIRONMENT=development
DJANGO_SECRET_KEY=local-dev-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,stg.plane.samsungds.net

# --- Security toggles --------------------------------------------------------
# 로컬 개발 시 HTTPS 관련 강제 옵션을 모두 해제합니다.
DJANGO_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# --- Corporate ADFS 인증서 ---------------------------------------------------
ADFS_CER_PATH=/app/login_certs/stsds.secsso.net.cer
