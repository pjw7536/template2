# 사내 Kubernetes 앱의 공용 운영 입력입니다.
# 이 파일을 권한 0600의 로컬 identity.env로 복사한 뒤 사내 운영값을 입력합니다.
# 적용 명령과 필드별 설명은 deploy/shared/docs/operations/02-deploy.md를 참조합니다.
# 선택 입력을 비우면 각 앱의 기존 env 또는 저장소 기본값을 사용합니다.
# 채워진 항목은 앱별 설정에 있던 초기값입니다. 기존 배포에는 현재 사용값을 확인합니다.

# 공용 배포 대상과 Traefik의 전체 VIP backend 목록입니다.
KUBE_CONTEXT=
VIP_BACKENDS=

# 사내 AD FS에서 발급받은 client ID입니다.
CORP_OIDC_CLIENT_ID=
# 사내 AD FS에서 발급받은 client secret입니다.
CORP_OIDC_CLIENT_SECRET=
# 추가할 기존 Keycloak 계정의 EPID입니다. 여러 명은 쉼표로 구분하며, 추가할 계정이 없으면 비웁니다.
IAM_PLATFORM_ADMIN_USERNAMES=

# 새 설치 또는 운영 설정이 다를 때만 입력합니다. 비우면 기존 KEYCLOAK_ENV 값을 사용합니다.
postgres-password=1bf8f8b2bb951f289b5ab4d4502f70686acae4acabcd44b0f4b9e0b02db630ea
bootstrap-admin-username=etch-admin
bootstrap-admin-password=dkssud123!
CORP_OIDC_DISCOVERY_URL=
CORP_OIDC_CLIENT_AUTH_METHOD=
keycloak-public-url=

# Etch Members 운영 설정이 다를 때만 입력합니다. 비우면 기존 IAM_ENV 값을 사용합니다.
IAM_PUBLIC_URL=
KEYCLOAK_TARGET_REALM=
IAM_STORAGE_NODE=
IAM_DATA_HOST_PATH=

# CSV 등록을 실행할 때만 경로를 입력합니다. 사용자 CSV를 지정하면 소속 CSV도 필요합니다.
KEYCLOAK_SDWTS_CSV=
KEYCLOAK_USERS_CSV=

# 기존 Headlamp 관리자 목록 또는 로그인 구성을 바꿀 때만 입력합니다.
# 관리자 목록은 기존 Keycloak 계정의 EPID를 쉼표로 구분합니다.
# Headlamp client secret은 배포 중 Keycloak에서 읽습니다.
HEADLAMP_ADMINS=
HEADLAMP_HOST=
HEADLAMP_IMAGE_PULL_SECRET=
HEADLAMP_OIDC_CLIENT_ID=
HEADLAMP_OIDC_ISSUER_URL=

# Airflow 배치, DB, 관리자 및 암호화 키입니다. 배포 중인 기존 값은 그대로 사용합니다.
AIRFLOW_NODE_NAME=
AIRFLOW_IMAGE_PULL_SECRET=
AIRFLOW_POSTGRES_MODE=
AIRFLOW_POSTGRES_HOST=
AIRFLOW_POSTGRES_PORT=
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
