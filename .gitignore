# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/portal/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.env
pm_spider/
# testing
/coverage

# next.js
.next/
/apps/portal/web/.next/
/apps/portal/web/out/

# production
/build
/dist
/apps/portal/web/dist

# vendor
vendor/

# misc
.DS_Store
*.pem

# Codex shared agent assets
.codex/*
!.codex/
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/
.codex/skills/.system/**
.codex/plugins/
.codex/cache/
.codex/log/
.codex/logs/
.codex/tmp/
.codex/**/*.env
.codex/**/secrets*
.specify/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경설정 예시는 추적하고 실제 운영 설정은 제외합니다.
!.env.example
/deploy/*/env/*.env
/deploy/portal/env/prod/*.env
/deploy/portal/env/prod/*.pre-k8s.bak
/apps/portal/api/.env
/apps/portal/web/.env.local
/apps/portal/web/.env.development.local
/apps/portal/web/.env.test.local
/apps/portal/web/.env.production.local

# vercel
/.vercel

# typescript
*.tsbuildinfo
apps/portal/web/next-env.d.ts

# python
*.pyc
__pycache__/
/apps/portal/api/.venv/
/apps/portal/api/db.sqlite3
/apps/portal/api/staticfiles/
/data/data_movement/
/data/l3_spider/daily_anomaly/
/data/postgres/

*/logs/
apps/portal/api/logs/rag_errors.log

# local dev data (mock Parquet generators)
/data/pm_spider/
/data/tttm_spider/data/
/data/tttm_spider/result/
/data/tttm_spider/lotwf_index.parquet

# editor / tool artifacts
.claude/
apps/portal/web/test-results/

# Windows Zone.Identifier sidecar files
*:Zone.Identifier

# system packages
*.deb
.tools/

# 앱 구조 개편 후 로컬 실행 데이터와 개인 설정은 원본에 포함하지 않습니다.
/data/airflow/

# 저장소 도구의 독립 Node 설치 산출물입니다.
/apps/tooling/node_modules/

# 로컬 Kubernetes의 생성 설정·자격증명·영속 데이터입니다.
/local/shared/runtime/
/local/shared/env/k8s.env
/data/k8s-local/
